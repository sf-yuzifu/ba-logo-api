{
  "name": "ba-logo-api",
  "version": "2.0.0",
  "type": "module",
  "module": "src/index.ts",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "samples": "bun run scripts/generate-samples.ts",
    "bench": "bun run scripts/benchmark.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@napi-rs/canvas": "^1.1.0",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "bun-types": "1.3.14",
    "typescript": "7.0.2"
  }
}
